# Do not 301 https://yardgrid.netlify.app or https://www.bloomandbedgarden.com here.
# A cross-host redirect drops #confirmation_token before any script can read it.
# js/config.js sends those hosts to the apex and keeps the hash.
http://bloomandbedgarden.com/*  https://bloomandbedgarden.com/:splat  301!
http://www.bloomandbedgarden.com/*  https://www.bloomandbedgarden.com/:splat  301!
http://yardgrid.netlify.app/*  https://yardgrid.netlify.app/:splat  301!
